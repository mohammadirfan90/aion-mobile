# Aion Mobile — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# never committed. The app reads these at startup via src/lib/env.ts
# (zod-validated, see SPEC §3).

# Public REST API base URL, WITHOUT a trailing `/api/v1`.
# Deployed API (Render, free tier: the first request after ~15 min idle takes 30–60 s).
EXPO_PUBLIC_API_URL=https://aion-7ysp.onrender.com

# Supabase project URL. Used by @supabase/supabase-js for auth.
# Example: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anonymous (publishable) key. Safe to ship in the app bundle —
# never put the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public web app base URL. Used for the "Get this course on the web" button
# on paid courses (CONTEXT D-04).
# Example: https://aion.example.com
EXPO_PUBLIC_WEB_URL=

# When `true`, every data hook returns a typed fixture from src/mocks and
# auth/login accept any email + password. Flip to `false` once the backend
# is reachable (Phase 2 complete).
EXPO_PUBLIC_USE_MOCKS=true
